# 실행 환경: development | test | production
NODE_ENV=
# Caddy가 인증서를 발급할 운영 도메인
DOMAIN=ilog.info
# ACME 인증서 만료 알림 이메일
ACME_EMAIL=
# 첫 검증은 staging URL로 바꾸고, 성공 후 production URL을 사용
ACME_CA=https://acme-v02.api.letsencrypt.org/directory
# 실제 web 이미지 배포 전 랜딩 페이지 사용 여부
BOOTSTRAP_MODE=false
# 서비스 절대 URL
APP_URL=
# 용량 티어: T0 | T1 | T2
CAPACITY_TIER=T0

# PostgreSQL 연결 문자열
DATABASE_URL=
# Compose PostgreSQL 데이터베이스명
POSTGRES_DB=aidream
# Compose PostgreSQL 사용자명
POSTGRES_USER=aidream
# 운영 DB 비밀번호 (실제 값 커밋 금지)
POSTGRES_PASSWORD=
# Redis 연결 문자열
REDIS_URL=

# 32자 이상의 Auth.js 암호화 키
AUTH_SECRET=
# 선택: Google OAuth 클라이언트 ID
AUTH_GOOGLE_ID=
# 선택: Google OAuth 클라이언트 시크릿
AUTH_GOOGLE_SECRET=

# S3 호환 Object Storage 엔드포인트
S3_ENDPOINT=
# Object Storage 리전
S3_REGION=
# Object Storage 액세스 키
S3_ACCESS_KEY_ID=
# Object Storage 시크릿 키
S3_SECRET_ACCESS_KEY=
# 원본 영상 버킷
S3_BUCKET_ORIGINALS=
# HLS 산출물 버킷
S3_BUCKET_HLS=
# 썸네일 버킷
S3_BUCKET_THUMBS=
# MinIO처럼 bucket policy를 쓰면 none, Akamai 공개 산출물은 public-read
S3_PUBLIC_OBJECT_ACL=none

# CDN 기본 URL
CDN_BASE_URL=

# 선택: SMTP 연결 문자열
SMTP_URL=
# 선택: 발신 이메일 주소
MAIL_FROM=

# 워커 동시 실행 수; T0은 1
WORKER_CONCURRENCY=1
# ffmpeg 실행 파일 경로
FFMPEG_PATH=ffmpeg
# ffprobe 실행 파일 경로
FFPROBE_PATH=ffprobe
# 트랜스코드 임시 디렉터리
TMP_DIR=/tmp/aidream
# 정리 잡 첫 운영 실행 시 true; 확인 후 false
DRY_RUN=true

# 로그 수준: trace | debug | info | warn | error
LOG_LEVEL=info

# 브라우저에 노출 가능한 서비스 URL
NEXT_PUBLIC_APP_URL=
# 브라우저에 노출 가능한 CDN URL
NEXT_PUBLIC_CDN_BASE_URL=

# CI가 생성한 커밋 SHA 기반 불변 운영 이미지
WEB_IMAGE=
WORKER_IMAGE=

# 로컬 MinIO 전용 자격증명 (운영 Object Storage와 분리)
MINIO_ROOT_USER=aidream-local
MINIO_ROOT_PASSWORD=aidream-local-secret
# 로컬 브라우저에서 MinIO로 직접 업로드할 수 있는 Origin 목록
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
