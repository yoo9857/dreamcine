# 실행 환경: development | test | production
NODE_ENV=
# 서비스 절대 URL
APP_URL=
# 용량 티어: T0 | T1 | T2
CAPACITY_TIER=T0

# PostgreSQL 연결 문자열
DATABASE_URL=
# Redis 연결 문자열
REDIS_URL=

# 32자 이상의 Auth.js 암호화 키
AUTH_SECRET=
# 선택: Google OAuth 클라이언트 ID
AUTH_GOOGLE_ID=
# 선택: Google OAuth 클라이언트 시크릿
AUTH_GOOGLE_SECRET=

# S3 호환 Object Storage 엔드포인트
S3_ENDPOINT=
# Object Storage 리전
S3_REGION=
# Object Storage 액세스 키
S3_ACCESS_KEY_ID=
# Object Storage 시크릿 키
S3_SECRET_ACCESS_KEY=
# 원본 영상 버킷
S3_BUCKET_ORIGINALS=
# HLS 산출물 버킷
S3_BUCKET_HLS=
# 썸네일 버킷
S3_BUCKET_THUMBS=

# CDN 기본 URL
CDN_BASE_URL=

# 선택: SMTP 연결 문자열
SMTP_URL=
# 선택: 발신 이메일 주소
MAIL_FROM=

# 워커 동시 실행 수; T0은 1
WORKER_CONCURRENCY=1
# ffmpeg 실행 파일 경로
FFMPEG_PATH=ffmpeg
# ffprobe 실행 파일 경로
FFPROBE_PATH=ffprobe
# 트랜스코드 임시 디렉터리
TMP_DIR=/tmp/aidream

# 로그 수준: trace | debug | info | warn | error
LOG_LEVEL=info

# 브라우저에 노출 가능한 서비스 URL
NEXT_PUBLIC_APP_URL=
# 브라우저에 노출 가능한 CDN URL
NEXT_PUBLIC_CDN_BASE_URL=
