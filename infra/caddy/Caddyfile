{
	email {$ACME_EMAIL}
	acme_ca {$ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
		-Via
	}
}

(fallback_csp) {
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: {$CDN_BASE_URL}; media-src 'self' blob: {$CDN_BASE_URL}; connect-src 'self' {$CDN_BASE_URL} {$S3_ENDPOINT}; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
}

http://{$DOMAIN} {
	import security_headers
	redir https://{$DOMAIN}{uri} permanent
}

http://www.{$DOMAIN} {
	import security_headers
	redir https://{$DOMAIN}{uri} permanent
}

www.{$DOMAIN} {
	import security_headers
	redir https://{$DOMAIN}{uri} permanent
}

# 이 VPS의 공용 Caddy는 DreamCine과 OneDayTrading의 TLS를 함께 종료한다.
# OneDayTrading 배포는 기존 aidream_default 네트워크에 oneday-web 별칭으로
# 참여하므로, 이 라우트도 Caddy의 영구 원본에 있어야 Caddy 재생성 뒤 유지된다.
www.onedaytrading.kr {
	import security_headers
	redir https://onedaytrading.kr{uri} permanent
}

onedaytrading.kr {
	encode zstd gzip
	import security_headers

	@oneday_api path /api/*
	header @oneday_api Cache-Control "no-store"

	@oneday_static path /_next/static/*
	header @oneday_static Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy oneday-web:3000 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
		health_uri /api/health
		health_interval 10s
	}

	handle_errors {
		import security_headers
		respond "Service temporarily unavailable" {http.error.status_code}
	}
}

{$DOMAIN} {
	encode zstd gzip
	import security_headers

	@api path /api/*
	header @api Cache-Control "no-store"

	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	# 공개 파생 미디어는 앱 서버를 거치지 않는다. CDN 도메인을 ilog.info로
	# 사용하는 동안 Caddy가 경로 첫 세그먼트를 실제 공개 버킷으로 매핑한다.
	# 원본 버킷은 의도적으로 어떤 경로에도 연결하지 않는다.
	handle /hls/* {
		rewrite * /{$S3_BUCKET_HLS}{uri}
		reverse_proxy {$S3_ENDPOINT} {
			header_up Host {upstream_hostport}
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
		}
		header Cache-Control "public, max-age=31536000, immutable"
	}

	handle /thumbs/* {
		rewrite * /{$S3_BUCKET_THUMBS}{uri}
		reverse_proxy {$S3_ENDPOINT} {
			header_up Host {upstream_hostport}
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
		}
		header Cache-Control "public, max-age=31536000, immutable"
	}

	request_body {
		max_size 2MB
	}

	@bootstrap {
		expression {$BOOTSTRAP_MODE:false} == true
		not path /api/*
	}
	handle @bootstrap {
		import fallback_csp
		root * /srv/bootstrap
		try_files {path} /index.html
		header Cache-Control "no-store"
		header X-AIDream-Mode "bootstrap"
		file_server
	}

	handle {
		reverse_proxy web:3000 {
			# 앱은 레이트리밋 신원으로 X-Forwarded-For 의 **첫 값**을 쓴다
			# (07_AUTH_SECURITY.md §8). Caddy 의 기본 동작은 들어온 XFF 에
			# 뒤로 덧붙이는 것이라, 클라이언트가 보낸 값이 첫 값으로 남는다.
			# 그러면 매 요청 XFF 를 바꿔 IP 레이트리밋을 그냥 우회할 수 있다.
			# 여기서 **덮어써서** "첫 값 = 실제 접속 IP" 를 성립시킨다. (OBS-006)
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
			header_up Host {host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {scheme}
			health_uri /api/health
			health_interval 10s
		}
	}

	handle_errors {
		import security_headers
		import fallback_csp
		respond "Service temporarily unavailable" {http.error.status_code}
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 20MiB
			roll_keep 3
			roll_keep_for 168h
		}
		format json
	}
}
