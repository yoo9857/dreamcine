{
  "title": "AIDREAM 서비스 개요",
  "uid": "aidream-service",
  "schemaVersion": 41,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "요청률",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(aidream_http_requests_total[5m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "5xx 비율",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(aidream_http_requests_total{status=\"5xx\"}[5m])) / clamp_min(sum(rate(aidream_http_requests_total[5m])), 1)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "응답시간 p50/p95/p99",
      "gridPos": { "x": 0, "y": 8, "w": 16, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(aidream_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(aidream_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(aidream_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "서비스 상태",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "targets": [{ "refId": "A", "expr": "min(up{job=~\"web|worker\"})" }]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "readiness 성공률",
      "gridPos": { "x": 0, "y": 16, "w": 8, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(aidream_http_requests_total{route=\"/api/ready\",status=\"2xx\"}[5m])) / clamp_min(sum(rate(aidream_http_requests_total{route=\"/api/ready\"}[5m])), 1)"
        }
      ]
    }
  ]
}
