{
  "title": "AIDREAM 미디어 파이프라인",
  "uid": "aidream-media",
  "schemaVersion": 41,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "큐 깊이",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "aidream_queue_depth",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "가장 오래 기다린 시간",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "aidream_queue_wait_seconds",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "잡 성공·실패율",
      "gridPos": { "x": 0, "y": 8, "w": 16, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue, status) (rate(aidream_jobs_total[5m]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "DLQ",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "targets": [
        { "refId": "A", "expr": "sum(increase(aidream_queue_dlq_total[24h]))" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "트랜스코드 처리시간 p50/p95",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(aidream_job_duration_seconds_bucket{queue=\"video.transcode\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(aidream_job_duration_seconds_bucket{queue=\"video.transcode\"}[5m])))",
          "legendFormat": "p95"
        }
      ]
    }
  ]
}
