{
  "title": "AIDREAM 인프라",
  "uid": "aidream-infra",
  "schemaVersion": 41,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU 사용률",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "메모리 사용률",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "디스크 사용률",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\"}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "애플리케이션 의존성",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [{ "refId": "A", "expr": "up", "legendFormat": "{{job}}" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "PostgreSQL 연결 사용률",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pg_stat_database_numbackends) / clamp_min(max(pg_settings_max_connections), 1)"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Redis 메모리 사용률",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "redis_memory_used_bytes / clamp_min(redis_memory_max_bytes, scalar(node_memory_MemTotal_bytes))"
        }
      ]
    }
  ]
}
