{
  "openapi": "3.1.0",
  "info": {
    "title": "AIDREAM API",
    "version": "0.0.0",
    "description": "05_API_CONTRACT.md 의 REST 계약. 현재 T03 인증·프로필·시스템과 T05 멀티파트 업로드 범위를 포함한다. 모든 응답은 no-store 이며 X-Request-Id 헤더를 가진다."
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "tags": [
    {
      "name": "auth",
      "description": "인증 · 계정 라이프사이클"
    },
    {
      "name": "me",
      "description": "내 프로필"
    },
    {
      "name": "uploads",
      "description": "멀티파트 업로드 · 재개"
    },
    {
      "name": "system",
      "description": "라이브니스 · 레디니스"
    }
  ],
  "components": {
    "headers": {
      "XRequestId": {
        "description": "로그 상관관계 ID",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "RetryAfter": {
        "description": "재시도 가능 시각까지의 초",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "authjs.session-token",
        "description": "Auth.js DB 세션 쿠키 (httpOnly, secure, sameSite=lax)"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "fields", "requestId"],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^E_[A-Z0-9_]+$"
              },
              "message": {
                "type": "string"
              },
              "fields": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                ]
              },
              "requestId": {
                "type": "string"
              }
            }
          }
        }
      },
      "SignupRequest": {
        "type": "object",
        "required": ["email", "password", "handle", "displayName"],
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 10
          },
          "handle": {
            "type": "string",
            "pattern": "^[a-z0-9_]{3,20}$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        }
      },
      "SignupResponse": {
        "type": "object",
        "required": ["id", "handle", "email", "emailVerified"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "emailVerified": {
            "type": "null"
          }
        }
      },
      "VerifyEmailRequest": {
        "type": "object",
        "required": ["token"],
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "VerifyEmailResponse": {
        "type": "object",
        "required": ["userId", "emailVerified"],
        "additionalProperties": false,
        "properties": {
          "userId": {
            "type": "string"
          },
          "emailVerified": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ForgotPasswordRequest": {
        "type": "object",
        "required": ["email"],
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "ResetPasswordRequest": {
        "type": "object",
        "required": ["token", "password"],
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "password": {
            "type": "string",
            "minLength": 10
          }
        }
      },
      "UpdateProfileRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "bio": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "maxLength": 500
              }
            ]
          },
          "avatarKey": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              }
            ]
          }
        }
      },
      "Me": {
        "type": "object",
        "required": [
          "id",
          "handle",
          "email",
          "displayName",
          "bio",
          "avatarUrl",
          "role",
          "status",
          "emailVerified",
          "createdAt"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "displayName": {
            "type": "string"
          },
          "bio": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "avatarUrl": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "format": "uri"
              }
            ]
          },
          "role": {
            "type": "string",
            "enum": ["VIEWER", "CREATOR", "MODERATOR", "ADMIN"]
          },
          "status": {
            "type": "string",
            "enum": ["ACTIVE", "SUSPENDED", "DELETED"]
          },
          "emailVerified": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateUploadRequest": {
        "type": "object",
        "required": ["fileName", "fileSize", "mimeType"],
        "additionalProperties": false,
        "properties": {
          "fileName": { "type": "string", "minLength": 1, "maxLength": 255 },
          "fileSize": { "type": "integer", "minimum": 1 },
          "mimeType": {
            "type": "string",
            "enum": [
              "video/mp4",
              "video/quicktime",
              "video/x-matroska",
              "video/webm"
            ]
          },
          "checksum": { "type": "string", "maxLength": 128 }
        }
      },
      "SignedPart": {
        "type": "object",
        "required": ["partNumber", "url", "expiresAt"],
        "additionalProperties": false,
        "properties": {
          "partNumber": { "type": "integer", "minimum": 1, "maximum": 10000 },
          "url": { "type": "string", "format": "uri" },
          "expiresAt": { "type": "string", "format": "date-time" }
        }
      },
      "CreateUploadResponse": {
        "type": "object",
        "required": [
          "uploadId",
          "partSize",
          "totalParts",
          "parts",
          "expiresAt"
        ],
        "additionalProperties": false,
        "properties": {
          "uploadId": { "type": "string" },
          "partSize": { "type": "integer", "minimum": 1 },
          "totalParts": { "type": "integer", "minimum": 1, "maximum": 10000 },
          "parts": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SignedPart" }
          },
          "expiresAt": { "type": "string", "format": "date-time" }
        }
      },
      "UploadSessionState": {
        "type": "object",
        "required": [
          "uploadId",
          "status",
          "fileName",
          "fileSize",
          "partSize",
          "totalParts",
          "completedParts",
          "expiresAt"
        ],
        "additionalProperties": false,
        "properties": {
          "uploadId": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["CREATED", "UPLOADING", "UPLOADED", "FAILED", "ABORTED"]
          },
          "fileName": { "type": "string" },
          "fileSize": { "type": "integer", "minimum": 1 },
          "partSize": { "type": "integer", "minimum": 1 },
          "totalParts": { "type": "integer", "minimum": 1, "maximum": 10000 },
          "completedParts": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1, "maximum": 10000 }
          },
          "expiresAt": { "type": "string", "format": "date-time" }
        }
      },
      "SignPartsRequest": {
        "type": "object",
        "required": ["partNumbers"],
        "additionalProperties": false,
        "properties": {
          "partNumbers": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1, "maximum": 10000 }
          }
        }
      },
      "CompleteUploadRequest": {
        "type": "object",
        "required": ["parts"],
        "additionalProperties": false,
        "properties": {
          "parts": {
            "type": "array",
            "description": "이번 브라우저 탭에서 새로 완료한 파트. 재개 전 파트는 서버가 병합한다.",
            "items": {
              "type": "object",
              "required": ["partNumber", "etag"],
              "additionalProperties": false,
              "properties": {
                "partNumber": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "etag": { "type": "string", "minLength": 1, "maxLength": 256 }
              }
            }
          }
        }
      },
      "CompleteUploadResponse": {
        "type": "object",
        "required": ["assetId", "status"],
        "additionalProperties": false,
        "properties": {
          "assetId": { "type": "string" },
          "status": { "type": "string", "enum": ["PENDING"] }
        }
      },
      "AgeConfirmRequest": {
        "type": "object",
        "required": ["confirmed"],
        "additionalProperties": false,
        "properties": {
          "confirmed": { "type": "boolean", "const": true },
          "birthYear": { "type": "integer", "minimum": 1900 }
        }
      },
      "SaveProgressRequest": {
        "type": "object",
        "required": ["positionSec"],
        "additionalProperties": false,
        "properties": {
          "positionSec": { "type": "integer", "minimum": 0 },
          "completed": { "type": "boolean" }
        }
      },
      "PlaybackResponse": {
        "type": "object",
        "required": [
          "episodeId",
          "masterUrl",
          "durationSec",
          "startAtSec",
          "renditions"
        ],
        "additionalProperties": false,
        "properties": {
          "episodeId": { "type": "string" },
          "masterUrl": { "type": "string", "format": "uri" },
          "posterUrl": { "type": "string", "format": "uri" },
          "durationSec": { "type": "integer", "minimum": 1 },
          "startAtSec": { "type": "integer", "minimum": 0 },
          "renditions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "width", "height"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "width": { "type": "integer", "minimum": 1 },
                "height": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      },
      "Health": {
        "type": "object",
        "required": ["status"],
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        }
      },
      "Ready": {
        "type": "object",
        "required": ["status", "checks"],
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok", "degraded"]
          },
          "checks": {
            "type": "object",
            "required": ["db", "redis", "storage"],
            "additionalProperties": false,
            "properties": {
              "db": {
                "type": "string",
                "enum": ["ok", "fail"]
              },
              "redis": {
                "type": "string",
                "enum": ["ok", "fail"]
              },
              "storage": {
                "type": "string",
                "enum": ["ok", "fail"]
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/auth/signup": {
      "post": {
        "tags": ["auth"],
        "summary": "이메일 회원가입 → 인증메일 발송",
        "description": "레이트리밋 10회 / 10분 (IP)",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "가입 성공",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignupResponse"
                }
              }
            }
          },
          "409": {
            "description": "E_USER_EMAIL_TAKEN / E_USER_HANDLE_TAKEN",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "E_VALIDATION",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "E_RATE_LIMITED",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/verify": {
      "post": {
        "tags": ["auth"],
        "summary": "이메일 인증 토큰 확인",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "인증 완료",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyEmailResponse"
                }
              }
            }
          },
          "422": {
            "description": "E_VALIDATION",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "E_RATE_LIMITED",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/password/forgot": {
      "post": {
        "tags": ["auth"],
        "summary": "비밀번호 재설정 메일 요청",
        "description": "계정이 없어도 204 를 반환한다 (존재 여부 노출 금지).",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPasswordRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "요청 접수",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            }
          },
          "422": {
            "description": "E_VALIDATION",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "E_RATE_LIMITED",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/password/reset": {
      "post": {
        "tags": ["auth"],
        "summary": "토큰으로 비밀번호 변경",
        "description": "토큰 TTL 1시간, 1회용. 성공 시 기존 세션 전부 무효화.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "변경 완료",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            }
          },
          "422": {
            "description": "E_VALIDATION",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "E_RATE_LIMITED",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/{nextauth}": {
      "parameters": [
        {
          "name": "nextauth",
          "in": "path",
          "required": true,
          "description": "Auth.js 내부 경로 (signin, signout, callback, session, csrf …)",
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "tags": ["auth"],
        "summary": "Auth.js 위임 (GET)",
        "security": [],
        "responses": {
          "200": {
            "description": "Auth.js 응답"
          }
        }
      },
      "post": {
        "tags": ["auth"],
        "summary": "Auth.js 위임 (POST)",
        "security": [],
        "responses": {
          "200": {
            "description": "Auth.js 응답"
          }
        }
      }
    },
    "/me": {
      "get": {
        "tags": ["me"],
        "summary": "내 프로필 + 역할",
        "responses": {
          "200": {
            "description": "현재 사용자",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "E_AUTH_REQUIRED / E_AUTH_SESSION_EXPIRED",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "E_AUTH_ACCOUNT_SUSPENDED",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "E_RATE_LIMITED",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": ["me"],
        "summary": "표시이름 / 소개 / 아바타 수정",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "수정된 사용자",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "E_AUTH_REQUIRED / E_AUTH_SESSION_EXPIRED",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "E_PERM_DENIED / E_AUTH_ACCOUNT_SUSPENDED",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "E_VALIDATION",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
