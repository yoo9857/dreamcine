{
  "openapi": "3.1.0",
  "info": {
    "title": "AIDREAM API",
    "version": "0.0.0",
    "description": "05_API_CONTRACT.md 의 REST 계약. 이 문서는 T03 범위(인증 · 내 프로필 · 시스템)만 포함하며 태스크가 진행될 때마다 확장된다. 모든 응답은 no-store 이며 X-Request-Id 헤더를 가진다."
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "tags": [
    {
      "name": "auth",
      "description": "인증 · 계정 라이프사이클"
    },
    {
      "name": "me",
      "description": "내 프로필"
    },
    {
      "name": "system",
      "description": "라이브니스 · 레디니스"
    }
  ],
  "components": {
    "headers": {
      "XRequestId": {
        "description": "로그 상관관계 ID",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "RetryAfter": {
        "description": "재시도 가능 시각까지의 초",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "authjs.session-token",
        "description": "Auth.js DB 세션 쿠키 (httpOnly, secure, sameSite=lax)"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "fields", "requestId"],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^E_[A-Z0-9_]+$"
              },
              "message": {
                "type": "string"
              },
              "fields": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                ]
              },
              "requestId": {
                "type": "string"
              }
            }
          }
        }
      },
      "SignupRequest": {
        "type": "object",
        "required": ["email", "password", "handle", "displayName"],
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 10
          },
          "handle": {
            "type": "string",
            "pattern": "^[a-z0-9_]{3,20}$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        }
      },
      "SignupResponse": {
        "type": "object",
        "required": ["id", "handle", "email", "emailVerified"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "emailVerified": {
            "type": "null"
          }
        }
      },
      "VerifyEmailRequest": {
        "type": "object",
        "required": ["token"],
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "VerifyEmailResponse": {
        "type": "object",
        "required": ["userId", "emailVerified"],
        "additionalProperties": false,
        "properties": {
          "userId": {
            "type": "string"
          },
          "emailVerified": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ForgotPasswordRequest": {
        "type": "object",
        "required": ["email"],
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "ResetPasswordRequest": {
        "type": "object",
        "required": ["token", "password"],
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "password": {
            "type": "string",
            "minLength": 10
          }
        }
      },
      "UpdateProfileRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "bio": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "maxLength": 500
              }
            ]
          },
          "avatarKey": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              }
            ]
          }
        }
      },
      "Me": {
        "type": "object",
        "required": [
          "id",
          "handle",
          "email",
          "displayName",
          "bio",
          "avatarUrl",
          "role",
          "status",
          "emailVerified",
          "createdAt"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "displayName": {
            "type": "string"
          },
          "bio": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "avatarUrl": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "format": "uri"
              }
            ]
          },
          "role": {
            "type": "string",
            "enum": ["VIEWER", "CREATOR", "MODERATOR", "ADMIN"]
          },
          "status": {
            "type": "string",
            "enum": ["ACTIVE", "SUSPENDED", "DELETED"]
          },
          "emailVerified": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": ["status"],
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        }
      },
      "Ready": {
        "type": "object",
        "required": ["status", "checks"],
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok", "degraded"]
          },
          "checks": {
            "type": "object",
            "required": ["db", "redis", "storage"],
            "additionalProperties": false,
            "properties": {
              "db": {
                "type": "string",
                "enum": ["ok", "fail"]
              },
              "redis": {
                "type": "string",
                "enum": ["ok", "fail"]
              },
              "storage": {
                "type": "string",
                "enum": ["ok", "fail"]
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/auth/signup": {
      "post": {
        "tags": ["auth"],
        "summary": "이메일 회원가입 → 인증메일 발송",
        "description": "레이트리밋 10회 / 10분 (IP)",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "가입 성공",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignupResponse"
                }
              }
            }
          },
          "409": {
            "description": "E_USER_EMAIL_TAKEN / E_USER_HANDLE_TAKEN",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "E_VALIDATION",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "E_RATE_LIMITED",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/verify": {
      "post": {
        "tags": ["auth"],
        "summary": "이메일 인증 토큰 확인",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "인증 완료",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyEmailResponse"
                }
              }
            }
          },
          "422": {
            "description": "E_VALIDATION",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "E_RATE_LIMITED",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/password/forgot": {
      "post": {
        "tags": ["auth"],
        "summary": "비밀번호 재설정 메일 요청",
        "description": "계정이 없어도 204 를 반환한다 (존재 여부 노출 금지).",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPasswordRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "요청 접수",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            }
          },
          "422": {
            "description": "E_VALIDATION",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "E_RATE_LIMITED",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/password/reset": {
      "post": {
        "tags": ["auth"],
        "summary": "토큰으로 비밀번호 변경",
        "description": "토큰 TTL 1시간, 1회용. 성공 시 기존 세션 전부 무효화.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "변경 완료",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            }
          },
          "422": {
            "description": "E_VALIDATION",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "E_RATE_LIMITED",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/{nextauth}": {
      "parameters": [
        {
          "name": "nextauth",
          "in": "path",
          "required": true,
          "description": "Auth.js 내부 경로 (signin, signout, callback, session, csrf …)",
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "tags": ["auth"],
        "summary": "Auth.js 위임 (GET)",
        "security": [],
        "responses": {
          "200": {
            "description": "Auth.js 응답"
          }
        }
      },
      "post": {
        "tags": ["auth"],
        "summary": "Auth.js 위임 (POST)",
        "security": [],
        "responses": {
          "200": {
            "description": "Auth.js 응답"
          }
        }
      }
    },
    "/me": {
      "get": {
        "tags": ["me"],
        "summary": "내 프로필 + 역할",
        "responses": {
          "200": {
            "description": "현재 사용자",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "E_AUTH_REQUIRED / E_AUTH_SESSION_EXPIRED",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "E_AUTH_ACCOUNT_SUSPENDED",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "E_RATE_LIMITED",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": ["me"],
        "summary": "표시이름 / 소개 / 아바타 수정",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "수정된 사용자",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "E_AUTH_REQUIRED / E_AUTH_SESSION_EXPIRED",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "E_PERM_DENIED / E_AUTH_ACCOUNT_SUSPENDED",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "E_VALIDATION",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "E_RATE_LIMITED",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["system"],
        "summary": "라이브니스 — 항상 200",
        "security": [],
        "responses": {
          "200": {
            "description": "프로세스 정상",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": ["system"],
        "summary": "레디니스 — DB / Redis / S3",
        "security": [],
        "responses": {
          "200": {
            "description": "모든 의존 서비스 정상",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ready"
                }
              }
            }
          },
          "503": {
            "description": "일부 의존 서비스 장애",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ready"
                }
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "sessionCookie": []
    }
  ]
}
